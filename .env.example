# =========================================================================
# Die Firma — environment template.
# Copy to .env and fill with REAL values. .env is git-ignored.
#
# HARD RULE (claude.md §6): no working default secrets. The startup check
# rejects known placeholders (changeme, bitte-ersetzen, xxx, your-key-here,
# ...) and enforces a minimum-entropy / format check. Leaving a value as a
# placeholder will ABORT the start.
# =========================================================================

# Anthropic API key. Required only when executor.mode = "claude_code" and for
# the SDK-driven agents (dispatcher/reviewer/sentinel). The mock executor and
# the full mock E2E run WITHOUT any key.
# Format: must start with "sk-ant-" and be sufficiently long.
ANTHROPIC_API_KEY=sk-ant-REPLACE-WITH-REAL-KEY

# Shared secret between the Python side (hooks + orchestrator) and the
# dashboard's /api/ingest endpoint. Must be high-entropy; generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
DIE_FIRMA_INGEST_TOKEN=REPLACE-WITH-RANDOM-32-BYTE-TOKEN

# Dashboard bind address + port. MUST stay on loopback (claude.md §6 / prompt §7).
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=4321

# Base URL the Python side uses to reach the dashboard ingest/read APIs.
DIE_FIRMA_DASHBOARD_URL=http://127.0.0.1:4321
