---
import Layout from "../components/Layout.astro";
import { getDb } from "../lib/db.ts";
import { createT, getLang, messages } from "../lib/i18n.ts";
import {
  agentStats,
  listEvents,
  listMetrics,
  listSubtasks,
  listTasks,
  liveRates,
  todaySpend,
} from "../lib/queries.ts";

export const prerender = false;

const lang = getLang();
const t = createT(lang);
const i18n = messages(lang);

// SSR initial snapshot from the read-model. The client then keeps it live via
// SSE (+ 2s polling fallback).
const db = getDb();
const tasks = listTasks(db).map((t) => ({ ...t, subtasks: listSubtasks(db, t.id) }));
const events = listEvents(db, { limit: 100 });
const metrics = listMetrics(db, 14);
const today = new Date().toISOString().slice(0, 10);
const bootstrap = {
  tasks,
  events,
  metrics,
  today,
  today_spend: todaySpend(db, today),
  agents: agentStats(db),
  live: liveRates(db, Date.now()),
  lang,
  i18n,
};
---

<Layout lang={lang}>
  <div class="shell">
  <header class="app">
    <h1>DIE&nbsp;FIRMA</h1>
    <span class="sub">{t("app.subtitle")}</span>
    <span class="conn" id="conn" data-state="polling" data-testid="conn-state">{t("conn.polling")}</span>
    <button class="theme-toggle" id="theme-toggle" type="button" data-testid="theme-toggle"
            aria-label={t("theme.toggle")} title={t("theme.toggle")}></button>
  </header>

  <main class="workspace">
   <div class="stack">
    <section class="panel new-job" aria-labelledby="newjob-h">
      <h2 id="newjob-h">{t("form.newJob")}</h2>
      <form id="job-form" data-testid="job-form" autocomplete="off">
        <div class="row">
          <label class="grow">
            <span>{t("form.title")}</span>
            <input id="job-title" name="title" type="text" required maxlength="200"
                   placeholder={t("form.titlePlaceholder")} />
          </label>
        </div>
        <div class="row">
          <label class="grow">
            <span>{t("form.description")} <em>{t("form.optional")}</em></span>
            <textarea id="job-description" name="description" rows="3"
                      placeholder={t("form.descPlaceholder")}></textarea>
          </label>
        </div>
        <div class="row">
          <label>
            <span>{t("form.type")}</span>
            <select id="job-type" name="type">
              <option value="code_gen">code_gen</option>
              <option value="code_review">code_review</option>
              <option value="automation">automation</option>
              <option value="data_prep">data_prep</option>
            </select>
          </label>
          <label>
            <span>{t("form.priority")}</span>
            <select id="job-priority" name="priority">
              <option value="1">{t("form.prio1")}</option>
              <option value="2" selected>{t("form.prio2")}</option>
              <option value="3">{t("form.prio3")}</option>
            </select>
          </label>
          <label>
            <span>{t("form.deliverable")}</span>
            <select id="job-deliverable" name="deliverable_format">
              <option value="file">file</option>
              <option value="git_branch">git_branch</option>
              <option value="report">report</option>
            </select>
          </label>
        </div>
        <div class="row">
          <label class="grow">
            <span>{t("form.verify")} <em>{t("form.optional")}</em></span>
            <input id="job-verify" name="verify" type="text" placeholder={t("form.verifyPlaceholder")} />
          </label>
          <label class="check">
            <input id="job-approve" name="requires_approval" type="checkbox" />
            <span>{t("form.requireApproval")}</span>
          </label>
        </div>
        <div class="row actions">
          <button type="submit" id="job-submit">{t("form.submit")}</button>
          <span class="form-msg" id="job-msg" role="status" aria-live="polite"></span>
        </div>
      </form>
    </section>

    <section class="panel" aria-labelledby="kanban-h">
      <h2 id="kanban-h">{t("kanban.title")}</h2>
      <div class="kanban" id="kanban" data-testid="kanban">
        <div class="col"><h3>{t("kanban.queue")} <span class="count" data-count="queue">0</span></h3><div data-col="queue"></div></div>
        <div class="col"><h3>{t("kanban.progress")} <span class="count" data-count="progress">0</span></h3><div data-col="progress"></div></div>
        <div class="col"><h3>{t("kanban.review")} <span class="count" data-count="review">0</span></h3><div data-col="review"></div></div>
        <div class="col"><h3>{t("kanban.done")} <span class="count" data-count="done">0</span></h3><div data-col="done"></div></div>
      </div>
    </section>

    <section class="panel" aria-labelledby="agents-h">
      <h2 id="agents-h">{t("agents.title")}</h2>
      <div class="agents" id="agents-body" data-testid="agents"></div>
      <p class="agents-legend">{t("agents.legend")}</p>
    </section>
   </div>

    <section class="panel terminal-panel" aria-label={t("panel.terminalChat")}>
      <div class="rtabs" role="tablist" aria-label={t("tabs.view")}>
        <button class="rtab active" type="button" role="tab" aria-selected="true" data-tab="terminal">
          {t("tab.terminal")} <span class="pps" id="term-rate" aria-hidden="true"></span>
        </button>
        <button class="rtab" type="button" role="tab" aria-selected="false" data-tab="chat">{t("tab.chat")}</button>
      </div>

      <div class="rview" data-view="terminal">
        <div class="term" id="term" data-testid="terminal" role="log" aria-live="polite" aria-label={t("terminal.stream")}></div>
      </div>

      <div class="rview is-hidden" data-view="chat">
        <div class="chat-controls">
          <label class="sr-only" for="chat-model">{t("chat.model")}</label>
          <select id="chat-model" data-testid="chat-model" aria-label={t("chat.model")}></select>
          <label class="rag"><input type="checkbox" id="chat-rag" checked /> <span>{t("chat.jobContext")}</span></label>
        </div>
        <div class="chat-log" id="chat-log" data-testid="chat-log" role="log" aria-live="polite" aria-label={t("chat.log")}></div>
        <form id="chat-form" data-testid="chat-form" autocomplete="off">
          <textarea id="chat-input" rows="2" placeholder={t("chat.inputPlaceholder")} aria-label={t("chat.message")}></textarea>
          <button id="chat-send" type="submit">{t("chat.send")}</button>
        </form>
      </div>
    </section>
  </main>

  <footer class="metrics-bar" id="metrics" data-testid="metrics" aria-label={t("metrics.bar")}></footer>
  </div>

  <div class="toasts" id="toasts" data-testid="toasts" role="alert" aria-live="assertive"></div>

  <script type="application/json" id="bootstrap" set:html={JSON.stringify(bootstrap)}></script>

  <script>
    type AnyTask = {
      id: string; type: string | null; priority: number | null; title: string | null;
      status: string | null; agent: string | null; total_tokens_in: number;
      total_tokens_out: number; total_cost_usd: number; error: string | null;
    };
    type AnyEvent = {
      id: number; task_id: string | null; kind: string; agent: string | null;
      status: string | null; message: string | null; ts: string;
    };
    type Metric = { date: string; tokens_in: number; tokens_out: number; cost_usd: number; tasks_done: number; tasks_failed: number };
    type AgentStat = {
      agent: string; tasks: number; active: number; tokens_in: number; tokens_out: number; cost_usd: number;
      last_kind: string | null; last_status: string | null; last_message: string | null; last_ts: string | null;
    };
    type Live = {
      window_sec: number; tokens_per_sec: number; tokens_in_per_sec: number; tokens_out_per_sec: number;
      events_per_sec: number; active_tasks: number;
      last_event_ts: string | null; idle_sec: number | null;
    };

    const COLS: Record<string, string> = {
      queued: "queue", awaiting_approval: "queue",
      planning: "progress", running: "progress",
      review: "review", blocked: "review",
      done: "done", failed: "done", cancelled: "done",
    };
    const AGENTS = ["dispatcher", "worker", "reviewer", "sentinel"];

    const $ = (sel: string, root: ParentNode = document) => root.querySelector(sel);
    const esc = (s: unknown) =>
      String(s ?? "").replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c] as string));
    const badge = (status: string | null) =>
      status
        ? `<span class="badge" data-status="${esc(status)}" style="background:var(--${status})">${esc(status)}</span>`
        : "";

    // i18n catalogue for the active language, injected via the bootstrap payload
    // so client-rendered labels match the server-rendered shell (review §5).
    let I18N: Record<string, string> = {};
    const T = (key: string, vars?: Record<string, string | number>) => {
      const tpl = I18N[key] ?? key;
      return vars ? tpl.replace(/\{(\w+)\}/g, (_m, k) => (k in vars ? String(vars[k]) : `{${k}}`)) : tpl;
    };

    // Toast notifications (review §7): surface backend/network errors instead of
    // hiding them in the console. Auto-dismiss; dismissable; deduped briefly.
    let lastToast = "";
    let lastToastAt = 0;
    function toast(message: string, kind: "error" | "ok" | "info" = "error", ttlMs = 6000) {
      const host = $("#toasts");
      if (!host) return;
      const now = Date.now();
      if (message === lastToast && now - lastToastAt < 3000) return; // dedupe bursts
      lastToast = message; lastToastAt = now;
      const el = document.createElement("div");
      el.className = "toast";
      el.dataset.kind = kind;
      el.innerHTML = `<span class="msg"></span><button class="x" type="button" aria-label="${esc(T("toast.dismiss"))}">×</button>`;
      (el.querySelector(".msg") as HTMLElement).textContent = message;
      const close = () => el.remove();
      (el.querySelector(".x") as HTMLButtonElement).addEventListener("click", close);
      host.appendChild(el);
      if (ttlMs > 0) window.setTimeout(close, ttlMs);
    }

    let tasks: AnyTask[] = [];
    let events: AnyEvent[] = [];
    let metrics: Metric[] = [];
    let agents: AgentStat[] = [];
    let todaySpend = { cost_usd: 0, tokens_in: 0, tokens_out: 0 };
    let today = "";
    let live: Live = {
      window_sec: 60, tokens_per_sec: 0, tokens_in_per_sec: 0, tokens_out_per_sec: 0,
      events_per_sec: 0, active_tasks: 0, last_event_ts: null, idle_sec: null,
    };

    function renderKanban() {
      const counts: Record<string, number> = { queue: 0, progress: 0, review: 0, done: 0 };
      const buckets: Record<string, string[]> = { queue: [], progress: [], review: [], done: [] };
      for (const t of tasks) {
        const col = COLS[t.status ?? "queued"] ?? "queue";
        counts[col] = (counts[col] ?? 0) + 1;
        buckets[col]!.push(
          `<article class="card" data-testid="task-card" data-task-id="${esc(t.id)}" style="--sc:var(--${esc(t.status ?? "queued")})">
             <div class="id">${esc(t.id.slice(0, 8))} · ${esc(t.type ?? "?")} · P${esc(t.priority ?? "?")}</div>
             <p class="title">${esc(t.title ?? T("card.untitled"))}</p>
             <div>${badge(t.status)} ${t.agent ? `<span class="badge">${esc(t.agent)}</span>` : ""}</div>
             ${t.error ? `<div class="id" style="color:var(--failed)">${esc(t.error)}</div>` : ""}
             ${t.status === "awaiting_approval"
               ? `<button class="approve" type="button" data-approve="${esc(t.id)}" data-testid="approve-btn">${esc(T("card.approve"))}</button>`
               : ""}
           </article>`,
        );
      }
      for (const c of Object.keys(buckets)) {
        const host = $(`[data-col="${c}"]`)!;
        host.innerHTML = buckets[c]!.length ? buckets[c]!.join("") : `<div class="empty">${esc(T("kanban.empty"))}</div>`;
        ($(`[data-count="${c}"]`) as HTMLElement).textContent = String(counts[c] ?? 0);
      }
    }

    // What each agent is responsible for + how to read its latest event.
    const agentRole = (a: string) => T(`role.${a}`);
    function agentAction(s: AgentStat | undefined): string {
      if (!s) return "—";
      if (s.last_message) return s.last_message;
      const parts = [s.last_kind, s.last_status].filter(Boolean);
      return parts.length ? parts.join(" · ") : "—";
    }
    // "busy" = touched something in the last 12s, or has an unfinished task.
    function isBusy(s: AgentStat | undefined): boolean {
      if (!s) return false;
      if ((s.active ?? 0) > 0) return true;
      if (!s.last_ts) return false;
      return Date.now() - Date.parse(s.last_ts) < 12_000;
    }

    function renderAgents() {
      const body = $("#agents-body")!;
      const byName = new Map(agents.map((a) => [a.agent, a]));
      // Bar = this agent's share of ALL tokens processed so far (real work
      // distribution). The worker dominates; dispatcher/sentinel are
      // deterministic and legitimately near 0 — so a busy agent with no tokens
      // yet gets an animated "working" bar instead of an empty one.
      const totalTok = AGENTS.reduce((sum, a) => {
        const s = byName.get(a);
        return sum + (s ? s.tokens_in + s.tokens_out : 0);
      }, 0);
      body.innerHTML = AGENTS.map((a) => {
        const s = byName.get(a);
        const tin = s?.tokens_in ?? 0;
        const tout = s?.tokens_out ?? 0;
        const tok = tin + tout;
        const busy = isBusy(s);
        const share = totalTok > 0 ? Math.round((tok / totalTok) * 100) : 0;
        // Working but nothing measured yet -> indeterminate animated bar.
        const pending = busy && tok === 0;
        const barTitle = totalTok > 0
          ? T("agent.tokenShare", { p: share, n: fmt(tok) })
          : busy ? T("agent.noTokensYet") : T("agent.noTokenWork");
        return `<article class="agent-card${busy ? " busy" : ""}" data-agent="${esc(a)}" data-testid="agent-card">
            <div class="agent-head">
              <span class="agent-dot"></span>
              <span class="name">${esc(a)}</span>
              <span class="role">${esc(agentRole(a))}</span>
              <span class="agent-state">${busy ? esc(T("agent.working")) : esc(T("agent.ready"))}</span>
            </div>
            <div class="agent-action" title="${esc(agentAction(s))}">${esc(agentAction(s))}</div>
            <div class="agent-meta"><span>${esc(T("agent.tasks"))} ${s?.active ?? 0}/${s?.tasks ?? 0}</span><span>${tok > 0 ? `${share}% · ${fmt(tin)}↓ ${fmt(tout)}↑` : (busy ? esc(T("agent.runningShort")) : "—")}</span></div>
            <div class="agent-bar${pending ? " pending" : ""}" title="${esc(barTitle)}"><i style="width:${pending ? 100 : share}%"></i></div>
          </article>`;
      }).join("");
    }

    function renderTerminal() {
      const term = $("#term")!;
      term.innerHTML = events
        .slice(0, 200)
        .map(
          (e) =>
            `<div class="line"><span class="t">${esc(e.ts)}</span> <span class="k">${esc(e.kind)}</span>` +
            `${e.agent ? " " + esc(e.agent) : ""}${e.status ? " [" + esc(e.status) + "]" : ""}` +
            `${e.task_id ? " " + esc(e.task_id.slice(0, 8)) : ""}${e.message ? " — " + esc(e.message) : ""}</div>`,
        )
        .join("");
    }

    // Compact number formatting so tiles never overflow (1.2k, 3.4M …).
    const fmt = (n: number, digits = 1) => {
      const v = Number.isFinite(n) ? n : 0;
      if (Math.abs(v) >= 1e6) return (v / 1e6).toFixed(digits) + "M";
      if (Math.abs(v) >= 1e3) return (v / 1e3).toFixed(digits) + "k";
      return v.toFixed(v < 10 && v !== Math.trunc(v) ? digits : 0);
    };

    function renderMetrics() {
      const host = $("#metrics")!;
      const idle = live.idle_sec === null || live.idle_sec > 5; // no event in >5s = quiet
      const active = live.tokens_per_sec > 0 || live.events_per_sec > 0;

      // Real, continuously-moving rates derived from the event stream — plus
      // today's cumulative totals for context. Order is symmetric: 4 live rates,
      // 3 cumulative.
      const m = metrics[0];
      const failedToday = m && m.date === today ? m.tasks_failed : 0;
      // Stall detection: while a task is active, show seconds since the last
      // event so a hang is visible (vs. "läuft" when telemetry keeps flowing).
      const idleSec = live.idle_sec === null ? null : Math.round(live.idle_sec);
      const activeSub = live.active_tasks > 0
        ? (idleSec !== null && idleSec > 20 ? T("metric.noActivity", { n: idleSec }) : T("metric.running"))
        : T("metric.quiet");
      const tiles: Array<[string, string, string, boolean]> = [
        [T("metric.tokensPerSec"), fmt(live.tokens_per_sec), `${fmt(live.tokens_in_per_sec)}↓ ${fmt(live.tokens_out_per_sec)}↑`, true],
        [T("metric.eventsPerSec"), fmt(live.events_per_sec), T("metric.window", { n: live.window_sec }), true],
        [T("metric.activeTasks"), String(live.active_tasks), activeSub, true],
        [T("metric.tokensToday"), fmt(todaySpend.tokens_in + todaySpend.tokens_out), `${fmt(todaySpend.tokens_in)} / ${fmt(todaySpend.tokens_out)}`, false],
        [T("metric.totalTasks"), String(tasks.length), T("metric.done", { n: tasks.filter((t) => t.status === "done").length }), false],
        [T("metric.failedToday"), String(failedToday), T("metric.failed"), false],
      ];

      host.innerHTML = tiles
        .map(
          ([l, v, sub, isLive]) =>
            `<div class="metric${isLive ? " live" : ""}${isLive && idle ? " idle" : ""}${active && isLive ? " hot" : ""}">
               <div class="v">${esc(v)}</div>
               <div class="l">${esc(l)}</div>
               <div class="l" style="opacity:.7">${esc(sub)}</div>
             </div>`,
        )
        .join("");

      const rate = $("#term-rate");
      if (rate) rate.textContent = active ? `${fmt(live.events_per_sec)} ev/s` : T("term.idle");
    }

    function renderAll() { renderKanban(); renderAgents(); renderTerminal(); renderMetrics(); }

    async function refresh() {
      const [tr, er, mr] = await Promise.all([
        fetch("/api/tasks").then((r) => r.json()),
        fetch("/api/events?limit=200").then((r) => r.json()),
        fetch("/api/metrics").then((r) => r.json()),
      ]);
      tasks = tr.tasks; events = er.events; metrics = mr.daily;
      agents = mr.agents ?? []; todaySpend = mr.today_spend; today = mr.today;
      if (mr.live) live = mr.live;
      renderAll();
    }

    // Theme toggle (review §8): flip data-theme on <html>, persist the choice,
    // and reflect the *next* state in the icon (☀ when dark -> switch to light).
    function syncThemeIcon() {
      const btn = $("#theme-toggle");
      if (btn) btn.textContent = document.documentElement.dataset.theme === "light" ? "☾" : "☀";
    }
    syncThemeIcon();
    $("#theme-toggle")?.addEventListener("click", () => {
      const next = document.documentElement.dataset.theme === "light" ? "dark" : "light";
      document.documentElement.dataset.theme = next;
      try { localStorage.setItem("df-theme", next); } catch { /* storage disabled */ }
      syncThemeIcon();
    });

    // Bootstrap from SSR snapshot for instant first paint.
    try {
      const boot = JSON.parse(($("#bootstrap") as HTMLScriptElement).textContent || "{}");
      I18N = boot.i18n ?? {};
      tasks = boot.tasks ?? []; events = boot.events ?? []; metrics = boot.metrics ?? [];
      agents = boot.agents ?? []; todaySpend = boot.today_spend ?? todaySpend; today = boot.today ?? "";
      if (boot.live) live = boot.live;
      renderAll();
    } catch { /* fall through to refresh() */ }

    // Live updates via SSE; on any event, re-pull authoritative projection.
    const conn = $("#conn") as HTMLElement;
    let pollTimer: number | undefined;
    function startPolling() {
      conn.dataset.state = "polling"; conn.textContent = "polling";
      pollTimer = window.setInterval(refresh, 2000);
    }
    function stopPolling() { if (pollTimer) window.clearInterval(pollTimer); pollTimer = undefined; }

    try {
      const es = new EventSource("/api/stream");
      es.onopen = () => { conn.dataset.state = "live"; conn.textContent = "live"; stopPolling(); };
      es.onmessage = () => refresh();
      es.addEventListener("error", () => { if (!pollTimer) startPolling(); });
      // Any named event also triggers a refresh.
      for (const k of ["task_created","task_updated","status_changed","log","error","escalation","cost_updated","token_usage","subtask_created","subtask_updated","agent_assigned","tool_call_start","tool_call_end"]) {
        es.addEventListener(k, () => refresh());
      }
    } catch { startPolling(); }

    // Live rates are wall-clock relative (they decay to 0 when idle), so the
    // metrics strip + agent table tick every 2s independently of the SSE feed
    // that drives the rest — otherwise the numbers would freeze between events.
    window.setInterval(async () => {
      try {
        const mr = await fetch("/api/metrics").then((r) => r.json());
        metrics = mr.daily; agents = mr.agents ?? []; todaySpend = mr.today_spend;
        today = mr.today; if (mr.live) live = mr.live;
        renderMetrics(); renderAgents();
      } catch { /* transient; next tick retries */ }
    }, 2000);

    // --- Neuer-Auftrag-Formular: POST an /api/jobs, dann sofort refresh -------
    function wireJobForm() {
      const form = $("#job-form") as HTMLFormElement | null;
      if (!form) return;
      const msg = $("#job-msg") as HTMLElement;
      const btn = $("#job-submit") as HTMLButtonElement;
      const val = (sel: string) => (($(sel) as HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement)?.value ?? "").trim();

      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        const title = val("#job-title");
        if (title === "") { msg.textContent = "Titel fehlt."; msg.dataset.kind = "err"; return; }
        const payload = {
          title,
          description: val("#job-description"),
          type: val("#job-type"),
          priority: Number(val("#job-priority")),
          deliverable_format: val("#job-deliverable"),
          verify: val("#job-verify") || null,
          requires_approval: ($("#job-approve") as HTMLInputElement).checked,
        };
        btn.disabled = true;
        msg.dataset.kind = ""; msg.textContent = "sende …";
        try {
          const res = await fetch("/api/jobs", {
            method: "POST",
            headers: { "content-type": "application/json" },
            body: JSON.stringify(payload),
          });
          const body = await res.json().catch(() => ({}));
          if (!res.ok) {
            msg.dataset.kind = "err";
            const detail = String(body.error ?? res.statusText);
            msg.textContent = T("error.generic") + ": " + esc(detail);
            toast(T("error.jobFailed") + ": " + detail, "error");
            return;
          }
          msg.dataset.kind = "ok";
          const idShort = esc(String(body.id ?? "").slice(0, 8));
          msg.textContent = body.requires_approval
            ? `angelegt ${idShort} — wartet auf Freigabe (./firma approve ${idShort}…)`
            : `angelegt ${idShort} — läuft in die Queue`;
          form.reset();
          void refresh();
        } catch (err) {
          msg.dataset.kind = "err";
          const detail = err instanceof Error ? err.message : String(err);
          msg.textContent = T("error.network") + ": " + esc(detail);
          toast(T("error.network") + ": " + detail, "error");
        } finally {
          btn.disabled = false;
        }
      });
    }
    wireJobForm();

    // --- Freigabe-Button auf Karten: POST an /api/approve, dann refresh -------
    // Delegiert auf den Kanban-Container, weil dessen innerHTML bei jedem Render
    // neu gebaut wird (einzelne Listener gingen sonst verloren).
    function wireApprovals() {
      const kanban = $("#kanban") as HTMLElement | null;
      if (!kanban) return;
      kanban.addEventListener("click", async (e) => {
        const btn = (e.target as HTMLElement)?.closest("[data-approve]") as HTMLButtonElement | null;
        if (!btn) return;
        const id = btn.dataset.approve;
        if (!id) return;
        btn.disabled = true;
        const prev = btn.textContent;
        btn.textContent = "freigegeben …";
        try {
          const res = await fetch("/api/approve", {
            method: "POST",
            headers: { "content-type": "application/json" },
            body: JSON.stringify({ id }),
          });
          if (!res.ok) {
            const body = await res.json().catch(() => ({}));
            const detail = String(body.error ?? res.statusText);
            btn.textContent = T("error.generic");
            btn.disabled = false;
            toast(T("error.approveFailed") + ": " + detail, "error");
            return;
          }
          // Der Orchestrator zieht die Freigabe beim nächsten Poll; refresh holt
          // die neue Projektion, sobald sich der Status ändert.
          void refresh();
        } catch (err) {
          btn.textContent = T("error.network");
          btn.disabled = false;
          toast(T("error.network") + ": " + (err instanceof Error ? err.message : String(err)), "error");
          void prev;
        }
      });
    }
    wireApprovals();

    // --- Rechte Spalte: Tabs (Terminal | Chat) ------------------------------
    function wireTabs() {
      const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>(".rtab"));
      const views = Array.from(document.querySelectorAll<HTMLElement>(".rview"));
      for (const tab of tabs) {
        tab.addEventListener("click", () => {
          for (const t of tabs) {
            const on = t === tab;
            t.classList.toggle("active", on);
            t.setAttribute("aria-selected", String(on));
          }
          const which = tab.dataset.tab;
          for (const v of views) v.classList.toggle("is-hidden", v.dataset.view !== which);
          if (which === "chat") (document.getElementById("chat-input") as HTMLTextAreaElement)?.focus();
        });
      }
    }
    wireTabs();

    // --- Chat (streaming, optional RAG über outbox) -------------------------
    const chatHistory: { role: string; content: string }[] = [];

    async function loadChatModels() {
      const sel = document.getElementById("chat-model") as HTMLSelectElement | null;
      if (!sel) return;
      const fallback = '<option value="qwen2.5:14b">qwen2.5:14b</option>';
      try {
        const r = await fetch("/api/ollama-models").then((x) => x.json());
        const models: string[] = r.models ?? [];
        if (!models.length) { sel.innerHTML = fallback; return; }
        sel.innerHTML = models.map((m) => `<option value="${esc(m)}">${esc(m)}</option>`).join("");
        sel.value = models.find((m) => m.includes("qwen2.5") && !m.includes("coder")) ?? models[0] ?? "qwen2.5:14b";
      } catch { sel.innerHTML = fallback; }
    }
    void loadChatModels();

    function addBubble(role: string, text: string): HTMLElement {
      const log = document.getElementById("chat-log")!;
      log.querySelector(".chat-empty")?.remove();
      const b = document.createElement("div");
      b.className = `bubble ${role}`;
      b.innerHTML = `<span class="who">${role === "user" ? "Du" : "LLM"}</span><span class="body"></span>`;
      (b.querySelector(".body") as HTMLElement).textContent = text;
      log.appendChild(b);
      log.scrollTop = log.scrollHeight;
      return b;
    }

    function wireChat() {
      const form = document.getElementById("chat-form") as HTMLFormElement | null;
      if (!form) return;
      const input = document.getElementById("chat-input") as HTMLTextAreaElement;
      const send = document.getElementById("chat-send") as HTMLButtonElement;
      const log = document.getElementById("chat-log")!;
      if (!log.children.length) log.innerHTML = `<div class="chat-empty">Stelle eine Frage zu deinen Deliverables.</div>`;

      async function submit() {
        const text = input.value.trim();
        if (!text) return;
        const model = (document.getElementById("chat-model") as HTMLSelectElement).value;
        const useRag = (document.getElementById("chat-rag") as HTMLInputElement).checked;
        addBubble("user", text);
        chatHistory.push({ role: "user", content: text });
        input.value = "";
        send.disabled = true;
        const bodyEl = addBubble("assistant", "…").querySelector(".body") as HTMLElement;
        try {
          const res = await fetch("/api/chat", {
            method: "POST",
            headers: { "content-type": "application/json" },
            body: JSON.stringify({ messages: chatHistory, model, useRag }),
          });
          if (!res.ok || !res.body) {
            const e = await res.json().catch(() => ({}));
            const detail = String(e.error ?? res.statusText);
            bodyEl.textContent = T("error.generic") + ": " + esc(detail);
            toast(T("error.chatFailed") + ": " + detail, "error");
            return;
          }
          const reader = res.body.getReader();
          const dec = new TextDecoder();
          let acc = "";
          bodyEl.textContent = "";
          for (;;) {
            const { done, value } = await reader.read();
            if (done) break;
            acc += dec.decode(value, { stream: true });
            bodyEl.textContent = acc;
            log.scrollTop = log.scrollHeight;
          }
          chatHistory.push({ role: "assistant", content: acc });
        } catch (err) {
          bodyEl.textContent = T("error.network");
          toast(T("error.network") + ": " + (err instanceof Error ? err.message : String(err)), "error");
        } finally {
          send.disabled = false;
          input.focus();
        }
      }

      form.addEventListener("submit", (e) => { e.preventDefault(); void submit(); });
      input.addEventListener("keydown", (e) => {
        if (e.key === "Enter" && !e.shiftKey) { e.preventDefault(); void submit(); }
      });
    }
    wireChat();

    void refresh();
  </script>
</Layout>
