{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "Mutation testing (review §7): checks the Vitest suite actually kills logic mutants. Optional + non-blocking; run with `npx stryker run`.",
  "packageManager": "npm",
  "testRunner": "vitest",
  "reporters": ["html", "clear-text", "progress"],
  "coverageAnalysis": "perTest",
  "mutate": [
    "src/lib/**/*.ts",
    "!src/lib/**/*.test.ts"
  ],
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": null
  }
}
