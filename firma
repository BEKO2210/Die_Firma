#!/usr/bin/env bash
# =============================================================================
# Die Firma — one-command launcher. Makes the whole system usable with a single
# script: it installs what's missing, generates a secure token, builds + starts
# the dashboard and the orchestrator, and gives you simple verbs for jobs.
#
#   ./firma start            # set up (once) + start dashboard + orchestrator
#   ./firma demo             # start + drop an example job and watch it flow
#   ./firma new "Title"      # create a job (no YAML needed) -> inbox
#   ./firma submit FILE.md   # drop an existing job file into the inbox
#   ./firma status           # show running services + task statuses
#   ./firma logs             # follow the live logs
#   ./firma stop             # stop both services
#   ./firma reset            # clear the read-model + state (fresh start)
#
# No API key required: the default executor is "mock" (deterministic). Switch to
# the real Claude worker later by editing config.toml + .env (see README).
# =============================================================================
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT"

DASH="$ROOT/apps/dashboard"
ORC="$ROOT/services/orchestrator"
VENV="$ROOT/.venv"
PY="$VENV/bin/python"
STATE="$ROOT/state"
LOG_DASH="$STATE/dashboard.log"
LOG_ORC="$STATE/orchestrator.log"
PID_DASH="$STATE/dashboard.pid"
PID_ORC="$STATE/orchestrator.pid"

# ---- pretty output ----------------------------------------------------------
c_blue=$'\033[34m'; c_green=$'\033[32m'; c_yellow=$'\033[33m'; c_red=$'\033[31m'; c_dim=$'\033[2m'; c_off=$'\033[0m'
say()  { printf '%s==>%s %s\n' "$c_blue" "$c_off" "$*"; }
ok()   { printf '%s ok %s %s\n' "$c_green" "$c_off" "$*"; }
warn() { printf '%s  ! %s %s\n' "$c_yellow" "$c_off" "$*"; }
die()  { printf '%s err%s %s\n' "$c_red" "$c_off" "$*" >&2; exit 1; }

need() { command -v "$1" >/dev/null 2>&1 || die "missing required tool: $1 (please install it)"; }

# ---- .env (auto-generate a real, high-entropy token) ------------------------
ensure_env() {
  if [ -f "$ROOT/.env" ]; then return; fi
  say "first run: creating .env with a secure random ingest token"
  need python3
  local token
  token="df_$(python3 -c 'import secrets;print(secrets.token_urlsafe(32))')"
  cat > "$ROOT/.env" <<EOF
# Auto-generated by ./firma on first run. Loopback-only; safe to keep local.
DIE_FIRMA_INGEST_TOKEN=$token
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=4321
DIE_FIRMA_DASHBOARD_URL=http://127.0.0.1:4321

# Executor: default is LOCAL Ollama (set in config.toml). Override here if you like:
#   DIE_FIRMA_EXECUTOR_MODE=ollama        # fully local (no key) — the default
#   DIE_FIRMA_OLLAMA_MODEL=qwen2.5-coder  # any model you've pulled
#   DIE_FIRMA_EXECUTOR_MODE=mock          # deterministic, no server (tests/demo)
# A real Anthropic key is ONLY needed for the optional claude_code executor:
ANTHROPIC_API_KEY=sk-ant-REPLACE-WITH-REAL-KEY
EOF
  ok "wrote .env (token generated automatically — no manual step needed)"
}

load_env() {
  set -a
  # shellcheck disable=SC1090,SC1091
  . "$ROOT/.env"
  set +a
  export HOST="${DASHBOARD_HOST:-127.0.0.1}"
  export PORT="${DASHBOARD_PORT:-4321}"
  export DIE_FIRMA_DB_PATH="${DIE_FIRMA_DB_PATH:-$STATE/dashboard.db}"
  export DIE_FIRMA_INBOX_DIR="${DIE_FIRMA_INBOX_DIR:-$ROOT/inbox}"
  export DIE_FIRMA_DASHBOARD_URL="${DIE_FIRMA_DASHBOARD_URL:-http://127.0.0.1:$PORT}"
  URL="$DIE_FIRMA_DASHBOARD_URL"
}

# ---- dependency setup (idempotent) ------------------------------------------
ensure_deps() {
  need node; need npm; need python3
  mkdir -p "$STATE"
  if [ ! -d "$DASH/node_modules" ]; then
    say "installing dashboard dependencies (one-time)"
    ( cd "$DASH" && npm install --no-fund --no-audit )
    ok "dashboard deps installed"
  fi
  if [ ! -x "$PY" ]; then
    say "creating Python virtualenv (.venv) and installing the orchestrator (one-time)"
    python3 -m venv "$VENV"
    "$PY" -m pip install --quiet --upgrade pip
    "$PY" -m pip install --quiet -e "$ORC"
    ok "orchestrator installed into .venv"
  fi
  if [ ! -f "$DASH/dist/server/entry.mjs" ]; then
    say "building the dashboard (one-time)"
    ( cd "$DASH" && npm run build >/dev/null )
    ok "dashboard built"
  fi
}

is_running() { [ -f "$1" ] && kill -0 "$(cat "$1")" 2>/dev/null; }

wait_ready() {
  for _ in $(seq 1 60); do
    curl -sf "$URL/api/metrics" >/dev/null 2>&1 && return 0
    sleep 0.5
  done
  return 1
}

# Effective executor mode/model (respects DIE_FIRMA_EXECUTOR_MODE + config.toml).
effective_executor() { ( cd "$ORC" && "$PY" -c \
  'from die_firma.config import load_config as L;c=L();print(c.executor_mode,c.ollama_url,c.ollama_model)' \
  2>/dev/null ); }

# Best-effort: when running locally on Ollama, make sure the server is up and the
# model is pulled. Never fatal — the orchestrator retries/blocks if it's not.
ollama_preflight() {
  local mode url model
  read -r mode url model <<<"$(effective_executor)" || return 0
  [ "$mode" = "ollama" ] || return 0
  say "executor = ollama (fully local, no API key) · model=$model · $url"
  if ! curl -sf "$url/api/tags" >/dev/null 2>&1; then
    warn "Ollama not reachable at $url."
    echo "      Install it from https://ollama.com, run 'ollama serve', then 'ollama pull $model'."
    echo "      Or run without a model:  DIE_FIRMA_EXECUTOR_MODE=mock ./firma start"
    return 0
  fi
  if ! curl -sf "$url/api/tags" | grep -q "\"$model\"" 2>/dev/null; then
    if command -v ollama >/dev/null 2>&1; then
      say "pulling Ollama model '$model' (first time only)…"
      ollama pull "$model" || warn "could not pull '$model' — pull it manually"
    else
      warn "model '$model' not found on the server — run: ollama pull $model"
    fi
  else
    ok "Ollama model '$model' is available"
  fi
}

# ---- commands ---------------------------------------------------------------
cmd_start() {
  ensure_env; load_env; ensure_deps
  if is_running "$PID_DASH"; then
    ok "dashboard already running (pid $(cat "$PID_DASH"))"
  else
    say "starting dashboard"
    ( cd "$DASH" && nohup node ./dist/server/entry.mjs >"$LOG_DASH" 2>&1 & echo $! >"$PID_DASH" )
    wait_ready || { warn "dashboard slow to start; see $LOG_DASH"; }
    ok "dashboard on $URL"
  fi
  ollama_preflight
  if is_running "$PID_ORC"; then
    ok "orchestrator already running (pid $(cat "$PID_ORC"))"
  else
    say "starting orchestrator"
    ( cd "$ORC" && nohup "$PY" -m die_firma.cli run >"$LOG_ORC" 2>&1 & echo $! >"$PID_ORC" )
    ok "orchestrator watching $ROOT/inbox"
  fi
  echo
  ok "Die Firma is up. Open: $c_green$URL$c_off"
  echo "   Create a job:  ./firma new \"Refactor the login flow\""
  echo "   Or try it now: ./firma demo"
}

cmd_stop() {
  load_env 2>/dev/null || true
  for pidf in "$PID_ORC" "$PID_DASH"; do
    if is_running "$pidf"; then
      kill "$(cat "$pidf")" 2>/dev/null || true
      ok "stopped $(basename "$pidf" .pid)"
    fi
    rm -f "$pidf"
  done
  # Sweep any stragglers from earlier runs whose PID file got overwritten — these
  # zombies keep polling the inbox and corrupt the board. The venv path is unique
  # to THIS checkout, so the match never hits another project.
  if pkill -f "$PY -m die_firma.cli run" 2>/dev/null; then
    ok "swept stray orchestrator process(es)"
  fi
  # Dashboard: kill whatever still holds our port (relative entry path isn't
  # uniquely matchable, so go by the port we own).
  local dpid
  dpid="$(ss -ltnpH "sport = :${PORT:-4321}" 2>/dev/null | grep -oP 'pid=\K[0-9]+' | head -1 || true)"
  if [ -n "${dpid:-}" ]; then
    kill "$dpid" 2>/dev/null || true
    ok "swept stray dashboard on port ${PORT:-4321}"
  fi
  ok "Die Firma stopped"
}

cmd_status() {
  load_env
  is_running "$PID_DASH" && ok "dashboard running (pid $(cat "$PID_DASH")) — $URL" || warn "dashboard not running"
  is_running "$PID_ORC"  && ok "orchestrator running (pid $(cat "$PID_ORC"))" || warn "orchestrator not running"
  echo
  ( cd "$ORC" && "$PY" -m die_firma.cli status ) 2>/dev/null || warn "no task data yet (is the dashboard running?)"
}

cmd_new()    { ensure_env; load_env; ensure_deps; ( cd "$ORC" && "$PY" -m die_firma.cli new "$@" ); }
cmd_submit() { ensure_env; load_env; ensure_deps; ( cd "$ORC" && "$PY" -m die_firma.cli submit "$@" ); }
cmd_approve(){ ensure_env; load_env; ( cd "$ORC" && "$PY" -m die_firma.cli approve "$@" ); }

cmd_demo() {
  # The demo is deterministic + instant: it forces the mock executor so it runs
  # with no Ollama/model and no API key, regardless of config.toml.
  export DIE_FIRMA_EXECUTOR_MODE=mock
  say "demo mode: forcing executor=mock (no Ollama/key needed)"
  cmd_stop >/dev/null 2>&1 || true
  cmd_start
  say "seeding an example job"
  ( cd "$ORC" && "$PY" -m die_firma.cli new "Demo: generate a greeting file" --verify "ls *.txt" >/dev/null )
  ok "job dropped — watch it move across the board at $URL"
  echo "   Tail the action: ./firma logs   ·   Stop: ./firma stop"
}

cmd_logs() {
  load_env
  say "following logs (Ctrl-C to stop)"
  touch "$LOG_DASH" "$LOG_ORC"
  tail -n 20 -f "$LOG_DASH" "$LOG_ORC"
}

cmd_reset() {
  load_env
  ( "$ROOT/scripts/reset.sh" ) || true
  ok "read-model + state cleared"
}

usage() {
  sed -n '2,33p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
}

main() {
  local cmd="${1:-help}"; shift || true
  case "$cmd" in
    start)   cmd_start ;;
    stop)    cmd_stop ;;
    restart) cmd_stop; cmd_start ;;
    status)  cmd_status ;;
    new)     cmd_new "$@" ;;
    submit)  cmd_submit "$@" ;;
    approve) cmd_approve "$@" ;;
    demo)    cmd_demo ;;
    logs)    cmd_logs ;;
    reset)   cmd_reset ;;
    help|-h|--help) usage ;;
    *) die "unknown command: $cmd (try ./firma help)" ;;
  esac
}

main "$@"
